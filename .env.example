# Copy to .env.local (local) or add in your host's environment settings.

# Postgres — Supabase / Neon / Railway connection string
DATABASE_URL=postgres://user:password@host:5432/dbname

# Dashboard login (HTTP Basic auth in the browser)
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me

# Shared secret your cron service sends as "Authorization: Bearer <CRON_SECRET>" to /api/sync
CRON_SECRET=generate-a-long-random-string

# eBay Developer Program → Application Keys (Production keyset)
EBAY_ENV=production            # or "sandbox"
EBAY_CLIENT_ID=                # App ID
EBAY_CLIENT_SECRET=            # Cert ID
EBAY_RUNAME=                   # RuName (eBay Redirect URL name), NOT the URL itself
EBAY_MARKETPLACE_ID=EBAY_GB

# Wix → Account settings → API Keys (needs "Wix Stores / eCommerce: Read Orders")
WIX_API_KEY=
WIX_SITE_ID=                   # the GUID in your Wix dashboard URL

# Listings: end & relist Buy It Now listings older than this many days (runs 6am UK, see vercel.json)
RELIST_AGE_DAYS=25
# Safety cap per daily run (any extra are done the next morning)
RELIST_MAX_PER_RUN=100
